---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import LinkButton from "@components/LinkButton.astro";
import Hr from "@components/Hr.astro";
import Card from "@components/Card";
import Socials from "@components/Socials.astro";
import getSortedPosts from "@utils/getSortedPosts";
import { SITE, SOCIALS } from "@config";

const posts = await getCollection("blog");

const sortedPosts = getSortedPosts(posts);
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);

const socialCount = SOCIALS.filter(social => social.active).length;
const imageModules = import.meta.glob("../picture/*.{jpg,jpeg,png,webp}", {
  eager: true,
  query: "?url",
  import: "default",
});

const images = Object.entries(imageModules).map(([path, src]) => ({
  src: src as string,
  alt: path.split("/").pop() ?? "Image du carrousel",
}));
---

<Layout>
  <Header />
  <main id="main-content">
    <section id="hero">
      <h1> Rien ne se perd, rien ne se crée tout se Recycle !</h1>
      <a
        target="_blank"
        href="/rss.xml"
        class="rss-link"
        aria-label="rss feed"
        title="RSS Feed"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="rss-icon"
          ><path
            d="M19 20.001C19 11.729 12.271 5 4 5v2c7.168 0 13 5.832 13 13.001h2z"
          ></path><path
            d="M12 20.001h2C14 14.486 9.514 10 4 10v2c4.411 0 8 3.589 8 8.001z"
          ></path><circle cx="6" cy="18" r="2"></circle>
        </svg>
        <span class="sr-only">RSS Feed</span>
      </a>

      <p>
        Recycle.mjb est une association avec pour objectif principal la réduction de l’empreinte 
        écologique de l’individu par la revalorisation des matériaux. Composée de passionné.e.s 
        de la fabrication mécanique elle réalise habituellement des vélo-cargos et autres ovnis de la route.
        En parallèle nous passons beaucoup de temps à remettre en état et construire de nouveaux outils
        pour étendre nos capacités de fabrication. Finalement, nous animons ponctuellement des chantiers 
        participatifs, nous permettant de faire circuler des connaissances techniques.
      </p>
         Mail : recycle.mjb@gmail.com
    
      </p>
       
      {
        // only display if at least one social link is enabled
        socialCount > 0 && (
          <div class="social-wrapper">
            <div class="social-links">Social Links:</div>
            <Socials />
          </div>
        )
      }
    </section>
    <section class="carousel">
      <button class="carousel-btn prev">‹</button>

      <div class="carousel-track">
      {images.map((image, index) => (
        <img
          src={image.src}
          alt={image.alt}
          class={`carousel-image ${index === 0 ? "active" : ""}`}
        />
      ))}
  </div>

  <button class="carousel-btn next">›</button>
</section>
